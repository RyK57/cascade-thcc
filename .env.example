# Environment

# Supabase — optional until you wire auth/data. App runs without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo seed account (pnpm db:seed)
DEMO_ACCOUNT_EMAIL=demo@prototype.local
DEMO_ACCOUNT_PASSWORD=PrototypeDemo123!
DEMO_ACCOUNT_NAME=Demo User

# Linq — iMessage/SMS partner API (https://docs.linqapp.com)
# Preferred key name used by @linqapp/sdk:
LINQ_API_V3_API_KEY=
# Alias also accepted by libs/linq:
LINQ_API_KEY=
# Webhook signing secret (whsec_...) — verified on /api/linq/webhook when set;
# leave empty for local `linq webhooks listen` forwarding
LINQ_WEBHOOK_SECRET=

# Terac — verified human labor REST API (https://terac.com)
TERAC_API_KEY=
# Optional override (default: https://terac.com/api/external/v2)
TERAC_API_BASE_URL=
# Project the agent drafts opportunities into (required for the chat loop)
TERAC_PROJECT_ID=

# Dynamic — SANDBOX only (Base Sepolia). Never production / real USD.
# Dashboard: https://app.dynamic.xyz — use a Sandbox environmentId
# Enable: Email OTP, Base Sepolia, Embedded Wallets, Allowed Origin http://localhost:3000
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=
# Alias accepted by agent-wallet helpers:
DYNAMIC_API_TOKEN=
# Cascade agent wallet (preferred escrow clearinghouse). Create via `pnpm agent:create-wallet`.
AGENT_WALLET_METADATA=
AGENT_WALLET_KEY_SHARES=
AGENT_WALLET_PASSWORD=
# Optional demo worker destination for Mission Control canvas
WORKER_WALLET_ADDRESS=
BASE_SEPOLIA_RPC_URL=
# Optional legacy treasury server-wallet (fallback when agent wallet unset).
DYNAMIC_SERVER_API_KEY=
DYNAMIC_SERVER_KEY_SHARES=
DYNAMIC_TREASURY_PASSWORD=
DYNAMIC_SANDBOX_RPC_URL=
DYNAMIC_SANDBOX_USDC_ADDRESS=
DYNAMIC_SANDBOX_TREASURY_ADDRESS=
# Phone-keyed wallets: set 1 to use Dynamic pregen API instead of derived placeholders
DYNAMIC_PREGEN_WALLETS=

# Linq outbound "from" for peer claim broadcasts (E.164)
LINQ_FROM_NUMBER=
LINQ_PHONE_NUMBER=

# Trust audit sampling (1 = every deliverable)
CASCADE_TRUST_AUDIT_EVERY=1
# Terac drafts are free; launching spends budget. Off by default — set to 1
# only if you accept an automatic launch per sampled deliverable.
CASCADE_TRUST_AUDIT_AUTOLAUNCH=

# Optional iMessage app card (otherwise plain-text status lines)
CASCADE_IMESSAGE_BUNDLE_ID=
CASCADE_IMESSAGE_TEAM_ID=
CASCADE_IMESSAGE_APP_NAME=Cascade

# Cron auth for /api/cron/poll-submissions
CRON_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Runware — image gen + vision (https://my.runware.ai; redeem code YCSSHACKATHON on the Wallet page)
RUNWARE_API_KEY=
