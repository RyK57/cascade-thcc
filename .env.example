# Environment

# Supabase — optional until you wire auth/data. App runs without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo seed account (pnpm db:seed)
DEMO_ACCOUNT_EMAIL=demo@prototype.local
DEMO_ACCOUNT_PASSWORD=PrototypeDemo123!
DEMO_ACCOUNT_NAME=Demo User

# Linq — iMessage/SMS partner API (https://docs.linqapp.com)
# Preferred key name used by @linqapp/sdk:
LINQ_API_V3_API_KEY=
# Alias also accepted by libs/linq:
LINQ_API_KEY=
# Webhook signing secret (whsec_...) — verified on /api/linq/webhook when set;
# leave empty for local `linq webhooks listen` forwarding
LINQ_WEBHOOK_SECRET=

# Terac — verified human labor REST API (https://terac.com)
TERAC_API_KEY=
# Optional override (default: https://terac.com/api/external/v2)
TERAC_API_BASE_URL=
# Project the agent drafts opportunities into (required for the chat loop)
TERAC_PROJECT_ID=

# Dynamic — JS SDK email OTP + embedded EVM wallet
# Dashboard: https://app.dynamic.xyz/dashboard/developer/api
# Enable: Email OTP, EVM chain(s), Embedded Wallets, Allowed Origin http://localhost:3000
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
